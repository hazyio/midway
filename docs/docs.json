{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Midway Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          {
            "expanded": false,
            "group": "Installation",
            "pages": [
              "installation/index",
              "installation/cargo",
              "installation/release-binary",
              "installation/shell-script",
              "installation/windows"
            ]
          },
          "config"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          {
            "expanded": false,
            "group": "Commands",
            "pages": [
              "commands/init",
              "commands/open"
            ]
          },
          {
            "expanded": false,
            "group": "Notifications",
            "pages": [
              "notifications/local",
              "notifications/slack",
              "notifications/ntfy",
              "notifications/discord",
              "notifications/telegram"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "label": "Github",
      "href": "https://github.com/hazyio/midway"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "aistudio"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/get_hazyio",
      "github": "https://github.com/hazyio/midway",
      "website": "https://hazyio.com"
    }
  }
}
